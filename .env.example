# Copy to .env and replace every replace-me.
# Passwords should be letters and numbers only. A $ or # will break Docker Compose.

# Local preview uses SQLite. On the server, comment the SQLite line and use MySQL.
DATABASE_URL=sqlite:///./vac2008.db
# DATABASE_URL=mysql+pymysql://vac2008:replace-me@sisuu_mysql:3306/vac2008

MYSQL_USER=vac2008
MYSQL_PASSWORD=replace-me
MYSQL_DATABASE=vac2008

SECRET_KEY=replace-me
DEBUG=true
DOMAIN=vac2008.com
ADMIN_PASSWORD=replace-me

# DeepSeek. Leave replace-me until you have a key. Cards still publish with a plain fallback.
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Aliyun mailbox. Port 465 is SSL from the start. 587 is not open on their SMTP server.
SMTP_HOST=smtp.qiye.aliyun.com
SMTP_PORT=465
SMTP_USER=postmaster@vac2008.com
SMTP_PASSWORD=replace-me
SMTP_FROM=postmaster@vac2008.com

# Lemon Squeezy. The checkout URL is the full buy link from their dashboard.
LEMONSQUEEZY_API_KEY=replace-me
LEMONSQUEEZY_STORE_ID=replace-me
LEMONSQUEEZY_VARIANT_ID=replace-me
LEMONSQUEEZY_WEBHOOK_SECRET=replace-me
LEMONSQUEEZY_CHECKOUT_URL=

# PayPal subscriptions. Leave the client id empty until the live app exists.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_ID=
PAYPAL_MODE=live
